# Caddy — the only service reachable from the internet (ports 80 and 443).
#
# Caddy gets and renews the HTTPS certificate from Let's Encrypt by itself,
# as soon as DNS points SITE_DOMAIN at this server. Nothing to install,
# nothing to renew by hand. The certificate is kept in the `caddy_data`
# volume, so restarts do not ask Let's Encrypt again.
#
# SITE_DOMAIN and MAX_UPLOAD_MB come from docker-compose.prod.yml.

# The site: everything goes to the Next.js server, which serves the pages
# and forwards /api/* to FastAPI. FastAPI itself is never exposed, so its
# /docs page is not reachable from outside (and is off outside development
# anyway).
{$SITE_DOMAIN} {
	request_body {
		max_size {$MAX_UPLOAD_MB}MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Chat replies stream as text/event-stream; Caddy passes those through
	# immediately without buffering.
	reverse_proxy web:3000
}

# www.ctrlai.my -> https://ctrlai.my, keeping the path.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Member apps (builder-static-runtime): apps.ctrlai.my/<app-slug>/.
#
# Static files only, from the `apps_data` volume, mounted read-only here;
# the api writes it when a member presses 미리보기 갱신. Nothing runs on
# the server — these files run in visitors' browsers. Because this host is
# same-site with ctrlai.my, three rules elsewhere keep it apart from the
# club's site (CLAUDE.md §2): the session cookie is host-only, every POST
# to the API must be JSON, and the API answers no CORS to this origin.
#
# Every response: the CSP below (only CTRL+AI may frame an app, and an app
# may load only its own files), nosniff, no Referer, and never a cookie.
# No directory listings; hidden names (the api's temporary folders) are
# never served. If DNS for apps.<domain> is missing, Caddy cannot get this
# certificate and keeps retrying — the main site is unaffected.
apps.{$SITE_DOMAIN} {
	root * /srv/apps

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors https://{$SITE_DOMAIN}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Set-Cookie
		-Server
	}

	@notRead not method GET HEAD
	respond @notRead 405

	file_server {
		hide .*
	}

	# A missing file is an error response, which the header block above
	# does not reach: answer it here with the same policy and no body.
	handle_errors {
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors https://{$SITE_DOMAIN}"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			-Server
		}
		respond "{err.status_code}" {err.status_code}
	}
}
