# Caddy — the only service reachable from the internet (ports 80 and 443).
#
# Caddy gets and renews the HTTPS certificate from Let's Encrypt by itself,
# as soon as DNS points SITE_DOMAIN at this server. Nothing to install,
# nothing to renew by hand. The certificate is kept in the `caddy_data`
# volume, so restarts do not ask Let's Encrypt again.
#
# SITE_DOMAIN and MAX_UPLOAD_MB come from docker-compose.prod.yml.

# The site: pages from the Next.js server, /api/* straight to FastAPI —
# the same one origin the browser has always seen (the Next.js /api rewrite
# stays for development; here caddy does that hop itself, so a request is
# held, not failed, while api is being replaced — chore-gapless-deploy,
# 2026-10-22). Only /api/* reaches the api from here: /docs, /_ctrlai/* and
# everything else of FastAPI stay unreachable from the site.
#
# During a deploy (deploy/update.sh): api is replaced first, then web. For
# the seconds a container is away, `lb_try_duration` keeps trying every
# 250 ms instead of answering at once — a member's click just takes a few
# seconds longer (a request that could not connect is always retried,
# whatever its method; one the old api had already started is not). Only
# when the hold runs out does handle_errors below answer: the 503 page for
# a page, a Korean JSON `detail` for /api/*.
{$SITE_DOMAIN} {
	request_body {
		max_size {$MAX_UPLOAD_MB}MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	@api path /api/*
	handle @api {
		# Next.js gzipped the api's JSON on the way through; keep that for
		# JSON only. A chat or Builder stream (text/event-stream, sent with
		# Cache-Control no-transform) is never touched, so the first piece
		# reaches the member at once (measured 2026-10-07: 0.06 s vs 0.46 s).
		encode zstd gzip {
			match {
				header Content-Type application/json*
			}
		}
		# ~6 s is what the new api needs on the e2-medium (imports, workers);
		# 30 s also covers a stop that waited for a long Builder call.
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	# Chat replies stream as text/event-stream; Caddy passes those through
	# immediately without buffering. Next.js is back ~2 s after it is
	# replaced; 15 s leaves room for a slow start.
	handle {
		reverse_proxy web:3000 {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Still nothing after the hold (a deploy that is taking longer, api or
	# web not starting): say so, in Korean, instead of a bare 502. The
	# page re-opens itself every 5 s (meta refresh); a script calling
	# /api/* gets the JSON shape the frontend already shows for errors.
	# Error routes do not get the `header` block above, so it is repeated.
	handle_errors 502 503 504 {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "SAMEORIGIN"
			Cache-Control "no-store"
			Retry-After "5"
			-Server
		}
		@apiError path /api/*
		handle @apiError {
			header Content-Type "application/json; charset=utf-8"
			respond `{"detail":"CTRL+AI를 업데이트하고 있어요. 잠시 뒤 다시 시도해 주세요."}` 503
		}
		handle {
			# deploy/ is mounted at /etc/caddy (docker-compose.prod.yml);
			# every path becomes this one file, so nothing else there is
			# served.
			rewrite * /maintenance.html
			file_server {
				root /etc/caddy
				status 503
			}
		}
	}
}

# www.ctrlai.my -> https://ctrlai.my, keeping the path.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Member apps: apps.ctrlai.my/<app-slug>/ (builder-static-runtime, and since
# app-platform P1 the "CTRL+AI 기능 상자" shell).
#
#   /<slug>/            OUR shell page, from the api (/_ctrlai/shell/<slug>):
#                       it runs the app in a frame sandboxed without
#                       allow-same-origin and is the only thing the app can
#                       talk to (postMessage, through /_ctrlai/sdk.js).
#   /<slug>/_app/<f>    the member's files, static from the `apps_data`
#                       volume (read-only here; the api writes it), with a
#                       `sandbox` CSP so they are fenced in even when opened
#                       on their own, and no network (connect-src 'none').
#   /_ctrlai/*          the api's app-platform router (scripts, shell,
#                       /_ctrlai/v1/*). Never the main /api: that is only
#                       reachable on the site itself.
#   /<slug>/_ctrlai/callback  where signing in to the app ends (P2): the api.
#   /<slug>, /<slug>/<f>  addresses from before the shell: redirected.
#
# Same-site with ctrlai.my, so the rules of CLAUDE.md §2 still hold: the
# session cookie is host-only (never sent here), every POST to the API is
# JSON, the API answers no CORS. The texts of the two CSPs are
# `app_shell.app_files_csp` / `shell_csp` — a test keeps them equal.
# If DNS for apps.<domain> is missing, Caddy cannot get this certificate
# and keeps retrying — the main site is unaffected.
apps.{$SITE_DOMAIN} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The three api proxies below hold a request while api is being
	# replaced, like the site's (chore-gapless-deploy).
	@platform path /_ctrlai/*
	handle @platform {
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	@shell path_regexp shell ^/([a-z2-9]{10})/$
	handle @shell {
		@notRead not method GET HEAD
		respond @notRead 405
		rewrite * /_ctrlai/shell/{re.shell.1}
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	# P2: the end of signing in to an app — the api spends the one-time
	# code and sets this app's cookie (Path /_ctrlai/, SameSite=Strict).
	@callback path_regexp callback ^/([a-z2-9]{10})/_ctrlai/callback$
	handle @callback {
		@notRead not method GET HEAD
		respond @notRead 405
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	# Cache-Control no-cache (fix-app-file-cache, 2026-10-19): a member's
	# files change with every 고치기 and keep their names, so Chrome
	# asks each time (an unchanged file is a 304 by its ETag). Without it
	# Chrome guessed a lifetime from the file's age and showed an old
	# index.html beside a new search.js for hours.
	@appfile path_regexp appfile ^/([a-z2-9]{10})/_app/(.+)$
	handle @appfile {
		@notRead not method GET HEAD
		respond @notRead 405
		header {
			Cache-Control "no-cache"
			Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-downloads; default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; frame-ancestors https://apps.{$SITE_DOMAIN} https://{$SITE_DOMAIN}"
			-Set-Cookie
		}
		root * /srv/apps
		rewrite * /{re.appfile.1}/{re.appfile.2}
		file_server {
			hide .*
		}
	}

	# Inside handle blocks, which are tried in order and exclusive: a bare
	# `redir` runs before every handle and would catch /<slug>/_app/ too.
	@bare path_regexp bare ^/([a-z2-9]{10})$
	handle @bare {
		redir * /{re.bare.1}/ permanent
	}

	@oldfile path_regexp oldfile ^/([a-z2-9]{10})/(.+)$
	handle @oldfile {
		redir * /{re.oldfile.1}/_app/{re.oldfile.2} permanent
	}

	handle {
		respond 404
	}

	# A missing file is an error response, which the header blocks above
	# do not reach: answer it here with a closed policy and no body.
	handle_errors {
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors https://{$SITE_DOMAIN}"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			-Server
		}
		respond "{err.status_code}" {err.status_code}
	}
}
