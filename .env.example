# Ctrl AI — example environment file.
#
# Copy this file to `.env` in the repository root and adjust values:
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is git-ignored and must never be committed.
# Both the backend (via pydantic-settings) and the frontend (via Next.js)
# read this single root-level file.

# ---------- Application ----------
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- Database ----------
# Matches the PostgreSQL service defined in docker-compose.yml.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://ctrlai:ctrlai@localhost:5432/ctrlai

# Used only by docker-compose.yml to initialise the local database container.
POSTGRES_USER=ctrlai
POSTGRES_PASSWORD=ctrlai
POSTGRES_DB=ctrlai
POSTGRES_PORT=5432

# ---------- Storage ----------
# Where generated files (video placeholders now, real assets later) are
# kept. `local` is a folder on this machine; Phase 9 switches this to
# cloud storage without any code change.
STORAGE_BACKEND=local
# Relative to `backend/`. Git-ignored.
STORAGE_DIR=var/storage

# ---------- CORS ----------
# Comma-separated list of browser origins allowed to call the backend.
#
# Mostly a safety net now: the browser calls /api/* on the frontend's own
# origin and Next.js forwards it to FastAPI, so ordinary requests are
# same-origin and never need CORS at all.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Session cookie ----------
# The session cookie is always HttpOnly, so no script on the page can read
# it. These flags are configurable so production can tighten them without
# a code change.
SESSION_COOKIE_NAME=ctrlai_session
# false locally: local development is plain HTTP, and a Secure cookie
# would never be sent. Production sets this to true (Phase 9).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Two weeks.
SESSION_MAX_AGE_SECONDS=1209600

# ---------- Seed administrator ----------
# Used ONLY by `python -m app.db.init_db`, which refuses to run outside
# development. Leave blank and no admin is created — there is deliberately
# no default password anywhere in the code.
#
# Choose a real password here; it is hashed with Argon2 before it is
# stored, and `.env` is git-ignored.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Frontend -> backend proxy ----------
# Where Next.js forwards /api/* (see frontend/next.config.ts). Read by the
# Next.js server, never by the browser, so it has no NEXT_PUBLIC_ prefix.
BACKEND_ORIGIN=http://127.0.0.1:8000

# ---------- Provider selection ----------
# Every external provider sits behind an interface with a mock
# implementation, and these variables choose which one is used.
# `mock` is the default everywhere, so the whole platform runs locally
# with no API keys and no domain. See CLAUDE.md section 20.
#
# Switching one of these to a real provider is a Phase 9 deployment
# change, not a code change. An empty key below is NOT an error while
# the matching provider is `mock`.
CLAUDE_PROVIDER=mock
VIDEO_PROVIDER=mock
GITHUB_PROVIDER=mock
YOUTUBE_PROVIDER=mock

# ---------- Provider credentials (NOT used yet) ----------
# Only needed when the matching provider above is switched off `mock`.
# All of these are server-side only. Never prefix any of them with
# NEXT_PUBLIC_, because NEXT_PUBLIC_* values are embedded into the
# browser bundle and are readable by anyone.
#
# Claude - chat, Builder assistance, video prompt/script help (Phase 2+).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Higgsfield - AI video generation (Phase 6).
HF_CREDENTIALS=

# GitHub App - per-user repository connection (Phase 4).
# Members are never asked for a personal access token.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# Google / YouTube - per-user channel connection and upload (Phase 7).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- Frontend (reference only) ----------
# Next.js reads `.env` files from the frontend/ directory, NOT from this
# root file, so this value is listed here for reference only. The
# frontend already defaults to http://localhost:8000; to override it,
# copy frontend/.env.local.example to frontend/.env.local.
#
# NEXT_PUBLIC_* variables ARE visible in the browser. Only non-secret
# values may ever use that prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
