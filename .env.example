# Ctrl AI — example environment file.
#
# Copy this file to `.env` in the repository root and adjust values:
#   PowerShell (your PC):   Copy-Item .env.example .env
#   Linux (the server):     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored and must never be committed.
# Both the backend (via pydantic-settings) and the frontend (via Next.js)
# read this single root-level file.
#
# ON THE SERVER (ctrlai-server) change the lines marked [SERVER]. The full
# list, with what to write, is in docs/deployment.md, step 3.

# ---------- Application ----------
# development (your PC) | beta (the invite-only beta) | production.
# [SERVER] APP_ENV=beta. The server refuses to start with development.
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 개인 충전 (personal top-ups). false everywhere until the owner decides
# real money may move (personal-topup-off, 2026-10-14): members see only
# the 동아리 지원 wallet, the top-up routes refuse in Korean, and charge()
# never touches personal money. The beta forces it off regardless.
PERSONAL_TOPUP_ENABLED=false

# ---------- Database ----------
# Matches the PostgreSQL service defined in docker-compose.yml.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# On the server this line is ignored: docker-compose.prod.yml builds the
# URL from POSTGRES_* below and points it at the `db` container.
DATABASE_URL=postgresql+psycopg://ctrlai:ctrlai@localhost:5432/ctrlai

# The backend tests that need real PostgreSQL use their own database,
# never DATABASE_URL's (test-database-isolation). Created on first use;
# the run refuses to start if it names the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://ctrlai:ctrlai@localhost:5432/ctrlai_test

# Used by docker-compose.yml (your PC) and docker-compose.prod.yml (the
# server) to create the database.
# [SERVER] POSTGRES_PASSWORD: a long random value, letters and digits only
#          (it goes inside a URL). Make one with:  openssl rand -hex 24
#          The server refuses to start with "ctrlai".
POSTGRES_USER=ctrlai
POSTGRES_PASSWORD=ctrlai
POSTGRES_DB=ctrlai
POSTGRES_PORT=5432

# ---------- Size (chosen for the e2-medium: 2 vCPU, 4 GB RAM, ~40 members) ----------
# API worker processes. Two use both vCPUs and leave memory for the rest.
WEB_CONCURRENCY=2
# Database connections per API worker, and the extra it may open under
# load: 2 workers x (5 + 5) = 20 at most, under PG_MAX_CONNECTIONS.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# PostgreSQL on the server (docker-compose.prod.yml): a quarter of the
# memory the db container may use, and room for 20 API connections plus
# migrations, the daily job and a psql session.
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=50
# Largest request body Caddy accepts, in MB. Chat attachments
# (chat-plus-files) will be limited below this by the backend.
MAX_UPLOAD_MB=20

# ---------- Storage ----------
# Where generated files (video placeholders now, real assets later) are
# kept. `local` is a folder on this machine; Phase 9 switches this to
# cloud storage without any code change.
STORAGE_BACKEND=local
# Relative to `backend/`. Git-ignored.
STORAGE_DIR=var/storage

# ---------- Server (docker-compose.prod.yml only) ----------
# [SERVER] The domain Caddy serves and gets the HTTPS certificate for.
#          www.<domain> redirects to it.
SITE_DOMAIN=ctrlai.my
# Where the images come from (built by .github/workflows/images.yml) and
# which build. `latest` is the newest merge into main.
IMAGE_PREFIX=ghcr.io/anoukkim/ctrl-ai-platform
IMAGE_TAG=latest

# ---------- CORS ----------
# Comma-separated list of browser origins allowed to call the backend.
#
# Mostly a safety net now: the browser calls /api/* on the frontend's own
# origin and Next.js forwards it to FastAPI, so ordinary requests are
# same-origin and never need CORS at all.
# [SERVER] CORS_ALLOW_ORIGINS=https://ctrlai.my
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Session cookie ----------
# The session cookie is always HttpOnly, so no script on the page can read
# it. These flags are configurable so production can tighten them without
# a code change.
SESSION_COOKIE_NAME=ctrlai_session
# false locally: local development is plain HTTP, and a Secure cookie
# would never be sent. On the server docker-compose.prod.yml forces true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Two weeks.
SESSION_MAX_AGE_SECONDS=1209600
# Blank = the cookie belongs to the main domain only (ctrlai.my), which is
# what the beta wants: there is no api subdomain. Leave it blank.
SESSION_COOKIE_DOMAIN=

# ---------- Site ----------
# Shown on the sign-up screen. Change it if the data ever moves.
DATA_LOCATION_NOTICE=회원님의 정보는 Google Cloud 서울 리전(asia-northeast3)에 저장됩니다.

# ---------- Administrator ----------
# Your PC: used by `python -m app.db.init_db` (development only). Leave
# ADMIN_USERNAME blank and no extra admin is created.
# [SERVER] used once by `python -m app.db.bootstrap`, which creates this
#          admin in the empty database. Afterwards the ADMIN_PASSWORD value
#          may be deleted from .env; the database keeps only an Argon2 hash.
#
# Outside development the server refuses to start while ADMIN_PASSWORD is
# a known default (devpassword, admin, password, the placeholder below) or
# shorter than 12 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me-before-deploying

# ---------- Frontend -> backend proxy ----------
# Where Next.js forwards /api/* (see frontend/next.config.ts). Read by the
# Next.js server, never by the browser, so it has no NEXT_PUBLIC_ prefix.
# Your PC only: the server's image was built with http://api:8000 (a build
# argument), so this line does nothing there.
BACKEND_ORIGIN=http://127.0.0.1:8000

# ---------- Provider selection ----------
# Every external provider sits behind an interface with a mock
# implementation, and these variables choose which one is used.
# `mock` is the default everywhere, so the whole platform runs locally
# with no API keys and no domain. See CLAUDE.md section 20.
#
# Switching one of these to a real provider is a Phase 9 deployment
# change, not a code change. An empty key below is NOT an error while
# the matching provider is `mock`.
CLAUDE_PROVIDER=mock
VIDEO_PROVIDER=mock
GITHUB_PROVIDER=mock
YOUTUBE_PROVIDER=mock

# ---------- Provider credentials (NOT used yet) ----------
# Only needed when the matching provider above is switched off `mock`.
# All of these are server-side only. Never prefix any of them with
# NEXT_PUBLIC_, because NEXT_PUBLIC_* values are embedded into the
# browser bundle and are readable by anyone.
#
# Claude - chat and video prompt help (Phase 2).
# [SERVER] when turning real Claude on: CLAUDE_PROVIDER=anthropic above and
#          the key here (docs/deployment.md, step 7).
# The key is needed only with CLAUDE_PROVIDER=anthropic; the server
# refuses to start without it then. The model is NOT chosen here: members
# pick it per conversation from the catalogue in Admin > AI Models
# (Haiku 4.5, Sonnet 5.5 and Opus 5.5 are seeded by the migration, Sonnet
# the default). ANTHROPIC_MODEL is only the fallback when that catalogue
# is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Admin > Budget shows this month's Anthropic spend (the USD sum of
# provider_cost) against this figure, warning at 80%. Informational —
# the hard stop is the monthly spend limit you set in the Anthropic
# Console. Empty = no bar.
ANTHROPIC_MONTHLY_BUDGET_USD=

# How Chat calls Claude. The defaults are what was agreed on 2026-10-07.
# (Named CHAT_*, not CLAUDE_*: Claude Code sets CLAUDE_EFFORT in its own
# terminals, and a backend started from one would silently pick it up.)
#   CHAT_THINKING   off = no thinking where the model allows it (Sonnet
#                   5.5); Opus 5.5 cannot turn it off and uses low effort
#   CHAT_EFFORT     low / medium / high
CHAT_THINKING=off
CHAT_EFFORT=low
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_CONTEXT_TOKENS=16000
CHAT_TIMEOUT_SECONDS=60
# Messages one member may send per minute.
CHAT_RATE_LIMIT_PER_MINUTE=10
# Prompt caching: each reply re-reads the conversation so far from
# Anthropic's cache at about a tenth of the input price. 5m costs 1.25x on
# the first write, 1h costs 2x and only pays off for 5-60 minute pauses.
CHAT_PROMPT_CACHE=true
CHAT_CACHE_TTL=5m
# Pause between the mock's streamed pieces, so the typing shows locally.
CHAT_MOCK_DELAY_MS=25

# Higgsfield - AI video generation (Phase 6).
HF_CREDENTIALS=

# GitHub App - per-user repository connection (Phase 4).
# Members are never asked for a personal access token.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# Google sign-in (google-login) — the main way members sign in.
# mock (default): no Google at all; offered in DEVELOPMENT ONLY (a mock
# anywhere else would let anyone claim any Google account). google: the
# real OAuth flow with PKCE, scopes openid/email/profile only.
# [SERVER] later: GOOGLE_LOGIN_PROVIDER=google and the three values below
#          from the Google Cloud console (docs/deployment.md, step 14).
#          The server refuses to start with google and any of them empty.
GOOGLE_LOGIN_PROVIDER=mock
# Also used by YouTube (Phase 7) on the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly as registered on the client, e.g. https://ctrlai.my/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------- Frontend (reference only) ----------
# Next.js reads `.env` files from the frontend/ directory, NOT from this
# root file, so this value is listed here for reference only. The
# frontend already defaults to http://localhost:8000; to override it,
# copy frontend/.env.local.example to frontend/.env.local.
#
# NEXT_PUBLIC_* variables ARE visible in the browser. Only non-secret
# values may ever use that prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
