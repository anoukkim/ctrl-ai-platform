# ---------- Python / backend ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.sqlite3
*.db

# Generated files kept by the local storage backend (STORAGE_DIR).
# Member assets are not source and must never reach a commit.
backend/var/

# ---------- Node / frontend ----------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ---------- Secrets & environment ----------
# Never commit real environment files. Only .env.example belongs in git.
.env
.env.*
!.env.example
!.env.local.example

# ---------- Claude Code ----------
# .claude/skills/ and other shared project config ARE committed, so the
# whole team gets them. Per-developer settings are not.
.claude/settings.local.json

# Git worktrees Claude Code creates for a branch. Each is a full checkout
# of the repository, so committing one would nest the project in itself.
.claude/worktrees/

# Transcript exports. Claude Code writes them into whichever directory it
# was started from, named <date>-<time>-<slug>.txt, and they can be over a
# megabyte of session log. Keep them out of git. Only the date-prefixed
# name is ignored, so an ordinary .txt file still commits normally.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
/frontend/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# ---------- Editors / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
npm-debug.log*
