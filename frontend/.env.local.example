# Frontend environment overrides.
#
# Next.js reads `.env` files from its own directory (frontend/), not from
# the repository root, so frontend-specific values live here.
#
# You normally do NOT need this file: lib/api.ts already defaults to
# http://localhost:8000. Copy it only to point the frontend at a
# different backend:
#   PowerShell:  Copy-Item .env.local.example .env.local
#
# Reminder: NEXT_PUBLIC_* values are embedded into the browser bundle.
# Never put an API key or any secret in this file.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
